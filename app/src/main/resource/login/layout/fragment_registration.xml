<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srcCompat="@drawable/ic_login_bg"
        android:scaleType="centerCrop"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:fadingEdge="none"
        android:scrollbars="none">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/dimen224dp"
                android:layout_height="@dimen/dimen224dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_splash_1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen24dp"
                android:layout_marginTop="@dimen/dimen20dp"
                android:gravity="center_horizontal"
                android:text="@string/municipal_rate_management_system"
                android:textAllCaps="true"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/dimen17sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen32dp"
                android:layout_marginTop="@dimen/dimen32dp"
                android:background="@drawable/bg_square_blue_border1"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/dimen6dp">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Name"
                    android:inputType="textPersonName"
                    android:padding="@dimen/dimen12dp"
                    android:textSize="@dimen/textMedium14sp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dimen24dp"
                    android:layout_height="@dimen/dimen24dp"
                    android:layout_gravity="center_vertical"
                    app:srcCompat="@drawable/ic_name" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/dimen32dp"
                android:layout_marginTop="@dimen/dimen12dp"
                android:background="@drawable/bg_square_blue_border1"
                android:orientation="horizontal"
                android:paddingEnd="@dimen/dimen6dp"
                android:paddingVertical="@dimen/dimen4dp">

                <com.hbb20.CountryCodePicker
                    android:id="@+id/ccp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    app:ccp_defaultNameCode="SL"
                    app:ccp_showNameCode="false"
                    app:ccp_textSize="@dimen/textMedium14sp"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint=""
                    android:layout_weight="1"
                    android:inputType="number"
                    android:padding="@dimen/dimen8dp"
                    android:textSize="@dimen/textMedium14sp" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dimen24dp"
                    android:layout_height="@dimen/dimen24dp"
                    android:layout_gravity="center_vertical"
                    app:srcCompat="@drawable/ic_phone" />
            </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen32dp"
            android:layout_marginTop="@dimen/dimen12dp"
            android:background="@drawable/bg_square_blue_border1"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dimen6dp">
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Username"
                android:inputType="textPersonName"
                android:padding="@dimen/dimen12dp"
                android:textSize="@dimen/textMedium14sp" />
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dimen24dp"
                android:layout_height="@dimen/dimen24dp"
                android:layout_gravity="center_vertical"
                app:srcCompat="@drawable/ic_name" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen32dp"
            android:layout_marginTop="@dimen/dimen12dp"
            android:background="@drawable/bg_square_blue_border1"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dimen6dp">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Email Address"
                android:inputType="textEmailAddress"
                android:padding="@dimen/dimen12dp"
                android:textSize="@dimen/textMedium14sp" />
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dimen24dp"
                android:layout_height="@dimen/dimen24dp"
                android:layout_gravity="center_vertical"
                app:srcCompat="@drawable/ic_email" />
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen32dp"
            android:layout_marginTop="@dimen/dimen12dp"
            android:background="@drawable/bg_square_blue_border1"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dimen6dp">
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="@dimen/dimen12dp"
                android:textSize="@dimen/textMedium14sp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dimen24dp"
                android:layout_height="@dimen/dimen24dp"
                android:layout_gravity="center_vertical"
                app:srcCompat="@drawable/ic_view" />
        </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tvBelowText"
                android:layout_alignParentEnd="true"
                android:layout_marginHorizontal="@dimen/dimen32dp"
                android:layout_marginTop="@dimen/dimen32dp"
                android:layout_marginBottom="@dimen/dimen12dp"
                android:background="@drawable/bg_btn_login1"
                android:gravity="center"
                android:clickable="true"
                android:padding="@dimen/dimen12dp"
                android:text="Register"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/textMedium14sp" />

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dimen40dp"
                android:layout_marginBottom="@dimen/dimen24dp"
                android:padding="@dimen/dimen8dp"
                android:text="@string/existing_user"
                android:textSize="@dimen/textSmall12sp" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>


</RelativeLayout>