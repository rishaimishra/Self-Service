<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@color/colorPrimary">

    <ImageView
        android:id="@+id/toolbar_iv_home"
        android:layout_width="@dimen/toolbar_back_height30dp"
        android:layout_height="@dimen/toolbar_back_height30dp"
        android:src="@drawable/ic_back_foreground"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/toolbar_tv_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Details"
        android:textColor="@color/colorWhite"
        android:textSize="@dimen/textMedium14sp"
        android:textStyle="bold"
        android:layout_marginStart="@dimen/dimen16dp"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/ivProfile"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivProfile"
        android:layout_width="@dimen/dimen24dp"
        android:layout_height="@dimen/dimen24dp"
        android:layout_marginEnd="@dimen/dimen16dp"
        android:src="@drawable/ic_edit_profile"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/ivNotification"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivNotification"
        android:layout_width="@dimen/dimen24dp"
        android:layout_height="@dimen/dimen24dp"
        android:layout_marginEnd="@dimen/dimen16dp"
        android:src="@drawable/ic_notification"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"/>


</RelativeLayout>