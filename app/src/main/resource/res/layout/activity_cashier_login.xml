<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:scrollbars="none"
    android:fadingEdge="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btUserLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Login With 919503595423"
            android:visibility="gone" />


        <ImageView
            android:layout_width="@dimen/dimen224dp"
            android:layout_height="@dimen/dimen224dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_splash"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen24dp"
            android:text="@string/municipal_rate_management_system"
            android:textAllCaps="true"
            android:gravity="center_horizontal"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/textMedium14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen8dp"
            android:gravity="center_horizontal"
            android:text="@string/self_service"
            android:textAllCaps="true"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/textMedium14sp"
            android:textStyle="bold" />



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/hi_cashier_please_sign_in_to_start_your_session"
            android:visibility="invisible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="60dp"
            android:layout_marginEnd="20dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_select_blue_button"
                android:fontFamily="@font/font_roboto_regular"
                android:text="@string/cashier"
                android:textAllCaps="false"
                android:textColor="@color/blue_light"
                android:textSize="13sp" />

            <View
                android:layout_width="10dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btUser"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_login"
                android:fontFamily="@font/font_roboto_regular"
                android:text="@string/user"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dimen24dp"
            android:layout_marginTop="@dimen/dimen20dp">

            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/font_roboto_regular"
                android:text="@string/council_cashier"
                android:textAllCaps="true"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/textSmall12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_below="@+id/tvHeader"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_square_blue_border"
                android:fontFamily="@font/font_roboto_regular"
                android:hint="@string/user_name2"
                android:inputType="textEmailAddress"
                android:paddingStart="10dp"
                android:text="ykoroma@svl.com"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_below="@+id/etEmail"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_square_blue_border"
                android:fontFamily="@font/font_roboto_regular"
                android:hint="@string/pass"
                android:inputType="textPassword"
                android:paddingStart="10dp"
                android:text="WardC@2019"
                android:textSize="13sp" />


            <Button
                android:id="@+id/btLogin"
                android:layout_width="150dp"
                android:layout_height="40dp"
                android:layout_below="@+id/etPassword"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/dimen20dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_login"
                android:fontFamily="@font/font_roboto_regular"
                android:text="@string/sign_in"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/textMedium14sp" />
        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen30dp"
            android:layout_marginHorizontal="@dimen/dimen24dp"
            android:text="@string/community_engagement_platform"
            android:textAllCaps="true"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/textSmall12sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btCheckIn"
            android:layout_width="@dimen/dimen150dp"
            android:layout_height="@dimen/dimen40dp"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/dimen12dp"
            android:layout_marginEnd="@dimen/dimen30dp"
            android:background="@drawable/bg_btn_login"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dimen16dp"
            android:paddingVertical="@dimen/dimen8dp"
            android:text="@string/check_in"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/textMedium14sp" />

        <TextView
            android:id="@+id/tvCashier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/dimen40dp"
            android:padding="@dimen/dimen8dp"
            android:textSize="@dimen/textSmall12sp"
            android:text="@string/not_cashier_please_click_here_to_sign_in" />


    </LinearLayout>
</ScrollView>
